# Copy to deploy/.env and change the passwords / token before using on a server.
POSTGRES_DB=school_planning
POSTGRES_USER=school
POSTGRES_PASSWORD=change-me
DB_PORT=5433
WEB_PORT=8080
# Sent as the X-Admin-Token header to POST /api/admin/reload after an import (empty = endpoint disabled)
ADMIN_TOKEN=
# Extra browser origins allowed to call the API directly, comma separated (empty = same origin only)
CORS_ORIGINS=
