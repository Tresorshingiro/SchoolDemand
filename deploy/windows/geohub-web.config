<?xml version="1.0" encoding="UTF-8"?>
<!--
  The dashboard served from the Geohub server, as https://gh.space.gov.rw/school/ (IIS application "school").
  Education Mapping is on gh.space.gov.rw too, so the dashboard in its frame is on the same site: the browser keeps the
  sign-in cookie there with no special settings. The data stays on the MINEDUC server: /school/api/* is forwarded to
  https://gis.mineduc.gov.rw/api/* (the API and its database).

  Folder of the "school" application (C:\inetpub\wwwroot\school): the files of dashboard\dist\ from a plain
  npm run build  (/school/ is the default base; VITE_API_URL not set: the page calls /school/api), plus this file
  renamed web.config. Deploy later builds by copying only the dist files: never overwrite this web.config.

  Only this application is configured here; nothing server-wide is needed or changed. It relies on what the Geohub
  server already has: URL Rewrite and Application Request Routing (ARR) with "Enable proxy", and access to
  https://gis.mineduc.gov.rw. No server variables are set and no allowedServerVariables section is listed (that section
  is locked on the Geohub server: listing it makes every address answer 500.52); the MINEDUC server answers the
  forwarded requests under the gh.space.gov.rw name and sets X-Forwarded-Proto itself. No outbound rules either: after
  a new build a hard refresh (Ctrl+F5) may be needed to see it.
  Then in Runtime Config, the "Schools Demand & Demographics" External URL: https://gh.space.gov.rw/school/dashboard
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="API to the MINEDUC server" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="https://gis.mineduc.gov.rw/api/{R:1}" />
        </rule>
        <rule name="Pages to index.html" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
    </rewrite>
    <!-- Data files uploaded in the admin portal: up to 50 MB (+ form overhead) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="57671680" />
      </requestFiltering>
    </security>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
