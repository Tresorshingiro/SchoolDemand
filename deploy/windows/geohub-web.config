<?xml version="1.0" encoding="UTF-8"?>
<!--
  The dashboard served from the Geohub server, as https://gh.space.gov.rw/school/ (IIS application "school").
  Education Mapping is on gh.space.gov.rw too, so the dashboard in its frame is on the same site: the browser keeps the
  sign-in cookie there with no special settings. The data stays on the MINEDUC server: /school/api/* is forwarded to
  https://gis.mineduc.gov.rw/api/* (the API and its database).

  Folder of the "school" application: dashboard\dist\* built with  $env:VITE_BASE='/school/'; npm run build
  (VITE_API_URL not set: the page calls /school/api), plus this file renamed web.config.
  Needs the IIS modules URL Rewrite and Application Request Routing (ARR), with "Enable proxy" ticked in
  ARR > Server Proxy Settings, and the Geohub server able to reach https://gis.mineduc.gov.rw.
  Then in Runtime Config, the "Schools Demand & Demographics" External URL: https://gh.space.gov.rw/school/dashboard
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="API to the MINEDUC server" stopProcessing="true">
          <match url="^api/(.*)" />
          <action type="Rewrite" url="https://gis.mineduc.gov.rw/api/{R:1}" />
          <serverVariables>
            <!-- the MINEDUC server answers for its own name, not gh.space.gov.rw -->
            <set name="HTTP_HOST" value="gis.mineduc.gov.rw" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
        <rule name="Pages to index.html" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="index.html" />
        </rule>
      </rules>
      <allowedServerVariables>
        <add name="HTTP_HOST" />
        <add name="HTTP_X_FORWARDED_PROTO" />
      </allowedServerVariables>
    </rewrite>
    <!-- Data files uploaded in the admin portal: up to 50 MB (+ form overhead) -->
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="57671680" />
      </requestFiltering>
    </security>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
