# Copy to backend/.env when running the API from source or as a Windows service.
# (With docker compose the settings come from deploy/.env instead.)
DATABASE_URL=postgresql+psycopg://school:change-me@localhost:5432/school_planning
# Header X-Admin-Token for POST /api/admin/reload after an import; empty = reload disabled (restart instead)
ADMIN_TOKEN=
# Only if the dashboard is served from another origin than the API, e.g. http://intranet:8080
CORS_ORIGINS=
# Sign-in: hours a session lasts without "Remember me", days with it
# SESSION_HOURS=12
# REMEMBER_DAYS=30
# Mark the sign-in cookie Secure: unset = when the API sees HTTPS; true / false to force. Set it to true on a server
# behind IIS with HTTPS: the API itself only sees plain HTTP from IIS.
# SESSION_COOKIE_SECURE=true
# A Secure cookie is also SameSite=None; Partitioned, so the dashboard stays signed in inside Education Mapping's frame
# (gh.space.gov.rw). false = SameSite=Lax (the dashboard then works only as a page of its own).
# SESSION_COOKIE_CROSS_SITE=false
# Sign-in checks usernames and passwords with this ArcGIS portal (every portal user can sign in)
# PORTAL_URL=https://gh.space.gov.rw/portal
# The address of this site as the portal sees it (the portal ties its token to it)
# PORTAL_REFERER=https://gh.space.gov.rw/school/
# PORTAL_TIMEOUT=15
# Only for a portal with a self-signed certificate
# PORTAL_VERIFY_SSL=false
# Where the import job finds Version 2.xlsx, Chachement area.xlsx and boundaries/ (default: ../data-sources)
# SCHOOL_DATA_DIR=D:\school-planning\data-sources

# Where uploaded data files are kept (default: ../data-uploads next to the backend folder)
# UPLOAD_DIR=D:\school-planning\uploads
