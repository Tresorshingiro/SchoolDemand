# Copy to backend/.env when running the API from source or as a Windows service.
# (With docker compose the settings come from deploy/.env instead.)
DATABASE_URL=postgresql+psycopg://school:change-me@localhost:5432/school_planning
# Header X-Admin-Token for POST /api/admin/reload after an import; empty = reload disabled (restart instead)
ADMIN_TOKEN=
# Only if the dashboard is served from another origin than the API, e.g. http://intranet:8080
CORS_ORIGINS=
# Sign-in: hours a session lasts without "Remember me", days with it
# SESSION_HOURS=12
# REMEMBER_DAYS=30
# Mark the sign-in cookie Secure: unset = when the browser used HTTPS; true / false to force
# SESSION_COOKIE_SECURE=true
# Where the import job finds Version 2.xlsx, Chachement area.xlsx and boundaries/ (default: ../data-sources)
# SCHOOL_DATA_DIR=D:\school-planning\data-sources

# Where uploaded data files are kept (default: ../data-uploads next to the backend folder)
# UPLOAD_DIR=D:\school-planning\uploads
